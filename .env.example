# ---------------------------------------------------------------------------
# SkillBridge LMS - Backend environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. Never commit real secrets.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Runtime --------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=localhost
LOG_LEVEL=info

# Database -------------------------------------------------------------------
# Option A - full connection string (takes precedence when set)
MONGODB_URI=

# Option B - discrete parts (used when MONGODB_URI is empty)
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DB_NAME=skillbridge_lms
# MONGODB_USER=
# MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# Authentication - REQUIRED --------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Change BOTH values before deploying.
JWT_SECRET=dev-only-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Cookies / CORS -------------------------------------------------------------
# Comma-separated allow-list of browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when the API is served over HTTPS.
COOKIE_SECURE=false
# Optional. Leave empty for host-only cookies.
COOKIE_DOMAIN=
# Frontend origin, used to build cookie/CORS defaults.
CLIENT_URL=http://localhost:5173

# Rate limiting --------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Seeding --------------------------------------------------------------------
# Local development only. The seed script creates demo accounts with this password.
SEED_PASSWORD="SkillBridge#2024"

# Logging --------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_PRETTY=false
